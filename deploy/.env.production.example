# ──────────────────────────────────────────────────────────────────────
#  Suite Académica Moodle · .env de PRODUCCIÓN
#  Copiar como `.env` en la raíz del proyecto y rellenar los valores
#  generados con `crypto.randomBytes`. NUNCA subir este fichero a git.
# ──────────────────────────────────────────────────────────────────────

# ═══ OBLIGATORIAS ═══════════════════════════════════════════════════════

# API de Anthropic (clave real, NO la de prueba)
ANTHROPIC_API_KEY=sk-ant-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Secreto de sesión: 48 bytes aleatorios. Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET=REEMPLAZA_CON_48_BYTES_BASE64_ALEATORIOS

# ═══ RECOMENDADAS EN PRODUCCIÓN ═════════════════════════════════════════

NODE_ENV=production

# HTTPS=true activa cookie.secure y rechaza/redirige POST por HTTP plano.
# Sólo poner a true si hay un reverse proxy con TLS delante (nginx, etc.)
HTTPS=true

# Bind sólo a loopback. El reverse proxy (nginx) hace el trabajo en :443.
HOST=127.0.0.1
PORT=3000

# Token para /api/health con métricas (32 bytes aleatorios). Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
HEALTH_TOKEN=REEMPLAZA_CON_32_BYTES_BASE64_ALEATORIOS

# 2FA obligatorio para administradores: ALTAMENTE recomendado.
REQUIRE_TOTP_FOR_ADMINS=true

# Usuario admin inicial. NO definir ADMIN_PASS aquí: el sistema generará
# una contraseña aleatoria y la dejará en data/ADMIN_INITIAL_PASSWORD.txt
# (permisos 0600). Cambiarla en el primer login y borrar ese fichero.
ADMIN_USER=admin

# ═══ MODELO Y LÍMITES ═══════════════════════════════════════════════════

ANTHROPIC_MODEL=claude-sonnet-4-6

# Límites de uso
MAX_FILE_MB=50           # tamaño máx por archivo subido
MAX_TOPICS=100           # nº máx de documentos por sesión
SESSION_HOURS=8          # duración de la cookie de sesión

# ═══ MAQUETACIÓN (ajustar sólo si hay problemas) ════════════════════════

MAQ_SINGLE_CHARS=18000   # umbral para llamada única vs chunking
MAQ_CHUNK_CHARS=18000    # tamaño de cada chunk
MAQ_MAX_TOKENS=32000     # max_tokens por llamada a Claude
MAQ_CONCURRENCY=3        # chunks en paralelo

# ═══ SEGURIDAD / MONITORING (defaults razonables) ═══════════════════════

# Tras N eventos sensibles (login_fail, login_locked, login_totp_fail) en
# ventana → warning a stderr.
MONITOR_THRESHOLD=20
MONITOR_WINDOW_MS=300000    # 5 minutos

# Rotación del audit.log al llegar a este tamaño (en bytes)
AUDIT_MAX_BYTES=5242880     # 5 MB

# Cuota de memoria por usuario en el cache de topics (en MB)
USER_TOPIC_BUDGET_MB=250

# Aislamiento de parsing PDF/DOCX en worker_threads
PARSE_TIMEOUT_MS=30000
PARSE_MEM_LIMIT_MB=512
