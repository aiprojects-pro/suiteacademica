# ─────────────────────────────────────────────────────────────────────
#  Secret con las credenciales sensibles.
#
#  IMPORTANTE: Este es un template. RELLENA los valores antes de aplicar
#  y NO LO SUBAS A NINGÚN REPOSITORIO PÚBLICO.
#
#  Generar secretos fuertes:
#    SESSION_SECRET="$(openssl rand -base64 48)"
#    HEALTH_TOKEN="$(openssl rand -base64 32)"
#
#  Crear el secret directamente con `oc create secret generic` es más seguro
#  que dejarlo en un fichero (ver INSTALL-OKD.md, sección 4).
# ─────────────────────────────────────────────────────────────────────
apiVersion: v1
kind: Secret
metadata:
  name: suiteacademica-secrets
  namespace: suiteacademica
type: Opaque
stringData:
  # Clave real de la API de Anthropic
  ANTHROPIC_API_KEY: "sk-ant-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"

  # 48 bytes aleatorios base64 (NUNCA el placeholder de .env.example)
  SESSION_SECRET: "REEMPLAZA_POR_OPENSSL_RAND_BASE64_48"

  # 32 bytes aleatorios base64
  HEALTH_TOKEN: "REEMPLAZA_POR_OPENSSL_RAND_BASE64_32"
