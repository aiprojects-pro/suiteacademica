# ──────────────────────────────────────────────────────────────────
#  Suite Académica Moodle · v6.0 · Variables de entorno
#  Copia como .env y completa los valores ANTES de arrancar
# ──────────────────────────────────────────────────────────────────

# API de Anthropic (OBLIGATORIA)
ANTHROPIC_API_KEY=sk-ant-XXXXXXXXXXXXXXXXXXXXXXXX

# Modelo de IA
# claude-opus-4-7 → máxima calidad · claude-sonnet-4-6 → equilibrio · claude-haiku-4-5-20251001 → más rápido/barato
ANTHROPIC_MODEL=claude-sonnet-4-6

# Servidor
PORT=3000
HOST=127.0.0.1
NODE_ENV=production
HTTPS=true

# ── Autenticación (OBLIGATORIO configurar antes del primer arranque) ──
# Secreto de sesión: cadena larga aleatoria (min. 32 caracteres)
SESSION_SECRET=cambia-esto-por-una-cadena-aleatoria-larga-y-segura

# Duración de sesión en horas (por defecto 8h)
SESSION_HOURS=8

# Credenciales del administrador inicial
# Si no existen usuarios, se crea este admin automáticamente al arrancar
ADMIN_USER=admin
ADMIN_PASS=cambiar-en-primer-login

# ── Límites ──────────────────────────────────────────────────────────
MAX_TOPICS=100
MAX_FILE_MB=50
BATCH_SIZE=25
MAX_CHARS=12000
CACHE_TTL_H=4

# ── Maquetación ──────────────────────────────────────────────────────
# Número de chunks que se procesan en paralelo (más alto = más rápido pero más
# llamadas concurrentes a la API). Recomendado: 3-5.
MAQ_CONCURRENCY=3
